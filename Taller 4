#include <stdio.h>
#define MAXPRODUCTOS 5
#define NOMBRE 50

char nombres[MAXPRODUCTOS][NOMBRE];
int tiempo[MAXPRODUCTOS];
int recursos[MAXPRODUCTOS];
int cantidad[MAXPRODUCTOS];
int total = 0;

int comparar(char a[], char b[]);
void copiar(char lugarfinal[], char origen[]);
int buscar(char nombre[]);

int main() {
    int opcion;
    do {
        printf("\n***MENU***\n");
        printf("1. Agregar Productos\n");
        printf("2. Mostrar Productos\n");
        printf("3. Editar Producto\n");
        printf("4. Eliminar Producto\n");
        printf("5. Resumen\n");
        printf("6. Salir del Programa\n");
        printf("Ingrese la opcion: ");
        scanf("%d", &opcion);
        getchar();

        switch (opcion) {
            case 1:
                if (total >= MAXPRODUCTOS) {
                    printf("Se alcanzo el maximo de productos\n");
                } else {
                    printf("Nombre del producto: ");
                    scanf(" %[^\n]", nombres[total]);
                    printf("Tiempo por unidad: ");
                    scanf("%d", &tiempo[total]);
                    printf("Recursos por unidad: ");
                    scanf("%d", &recursos[total]);
                    printf("Cantidad demandada: ");
                    scanf("%d", &cantidad[total]);
                    getchar();
                    total++;
                }
                break;

            case 2:
                if (total == 0) {
                    printf("No hay productos\n");
                } else {
                    for (int i = 0; i < total; i++) {
                        printf("%d %s, Tiempo: %d, Recursos: %d, Cantidad: %d\n",
                               i + 1, nombres[i], tiempo[i], recursos[i], cantidad[i]);
                    }
                }
                break;

            case 3: {
                char nombre[NOMBRE];
                printf("Ingrese el nombre del producto a editar: ");
                scanf(" %[^\n]", nombre);
                int posicion = buscar(nombre);
                if (posicion == -1) {
                    printf("Producto no encontrado\n");
                } else {
                    printf("Nuevo nombre: ");
                    scanf(" %[^\n]", nombres[posicion]);
                    printf("Nuevo tiempo del producto por unidad: ");
                    scanf("%d", &tiempo[posicion]);
                    printf("Nuevos recursos del producto por unidad: ");
                    scanf("%d", &recursos[posicion]);
                    printf("Nueva cantidad demandada: ");
                    scanf("%d", &cantidad[posicion]);
                }
                break;
            }

            case 4: {
                char nombre[NOMBRE];
                printf("Nombre del producto a eliminar: ");
                scanf(" %[^\n]", nombre);
                int pos = buscar(nombre);
                if (pos == -1) {
                    printf("Producto no encontrado\n");
                } else {
                    for (int i = pos; i < total - 1; i++) {
                        copiar(nombres[i], nombres[i + 1]);
                        tiempo[i] = tiempo[i + 1];
                        recursos[i] = recursos[i + 1];
                        cantidad[i] = cantidad[i + 1];
                    }
                    total--;
                    printf("Eliminado...\n");
                }
                break;
            }

            case 5: {
                int tiempototal = 0, recursostotales = 0;
                for (int i = 0; i < total; i++) {
                    tiempototal += tiempo[i] * cantidad[i];
                    recursostotales += recursos[i] * cantidad[i];
                }
                printf("Tiempo total necesario: %d\n", tiempototal);
                printf("Recursos totales necesarios: %d\n", recursostotales);
                int tiempodisponible, recursosdisponibles;
                printf("Tiempo disponible: ");
                scanf("%d", &tiempodisponible);
                printf("Recursos disponibles: ");
                scanf("%d", &recursosdisponibles);
                if (tiempototal <= tiempodisponible && recursostotales <= recursosdisponibles) {
                    printf("Se cumple lo necesario\n");
                } else {
                    printf("No se cumple lo necesario\n");
                }
                break;
            }

            case 6:
                printf("Saliendo del programa---\n");
                break;

            default:
                printf("Opcion no valida\n");
                break;
        }
    } while (opcion != 6);
    return 0;
}

int buscar(char nombre[]) {
    for (int i = 0; i < total; i++) {
        if (comparar(nombres[i], nombre)) {
            return i;
        }
    }
    return -1;
}

void copiar(char lugarfinal[], char origen[]) {
    int i = 0;
    while (origen[i] != '\0') {
        lugarfinal[i] = origen[i];
        i++;
    }
    lugarfinal[i] = '\0';
}

int comparar(char a[], char b[]) {
    int i = 0;
    while (a[i] != '\0' || b[i] != '\0') {
        if (a[i] != b[i])
            return 0;
        i++;
    }
    return 1;
}
